# Neon Postgres — Console → Project → Connect (ใช้ connection string แบบ pooled)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon Auth — Console → Project → Branch → Auth → Configuration
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
# สร้างด้วย: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=your-secret-at-least-32-characters-long

# ส่งอีเมลแจ้งเตือนผ่าน Gmail SMTP — App Password สร้างที่ myaccount.google.com/apppasswords
GMAIL_USER=noreply@example.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# อีเมลที่เข้าหน้า /admin ได้ (คั่นด้วย comma)
ADMIN_EMAILS=admin@example.com,another@example.com

# ปลายทางอีเมลแจ้งเตือน lead ใหม่ — ใส่ได้หลายอีเมล คั่นด้วย comma
ADMIN_EMAIL=your@email.com,teammate@email.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
